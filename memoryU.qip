set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "memoryU.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "memoryU.bsf"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "memoryU_inst.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "memoryU.inc"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "memoryU.cmp"]
