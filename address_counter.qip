set_global_assignment -name IP_TOOL_NAME "LPM_COUNTER"
set_global_assignment -name IP_TOOL_VERSION "18.1"
set_global_assignment -name IP_GENERATED_DEVICE_FAMILY "{MAX 10}"
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "address_counter.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "address_counter.bsf"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "address_counter_inst.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "address_counter.inc"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "address_counter.cmp"]
